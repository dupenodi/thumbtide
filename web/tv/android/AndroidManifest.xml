<?xml version="1.0" encoding="utf-8"?>
<!-- The Android TV app: one full-screen WebView showing the TV page (see MainActivity.java and scripts/android-tv.mjs).
     versionCode and versionName are set at build time from web/package.json. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.thumbtide.tv">

  <uses-permission android:name="android.permission.INTERNET" />

  <!-- A TV app with no touchscreen, that still installs on phones and tablets for testing -->
  <uses-feature android:name="android.software.leanback" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

  <!-- usesCleartextTraffic: the relay on this computer is plain ws:// and http:// on the home network -->
  <application
    android:label="Thumbtide"
    android:icon="@mipmap/icon"
    android:banner="@drawable/banner"
    android:hardwareAccelerated="true"
    android:usesCleartextTraffic="true"
    android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:screenOrientation="landscape"
      android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
