# Boomtown: the phone controller and the game's pace.
# Save this file and phones pick up the change. Syntax and every setting: web/src/games/kit/pad.ts
# The phone shows your cash and plots, and the actions of the moment as big buttons (controller.ts draws them; they
# are listed here for the help sheet and their haptics).

controller
  orientation  portrait

button roll
  label        "Roll"
  hint         "On your turn, roll the two dice and move your pawn. When you are done, tap End turn; an idle turn ends by itself."
  haptic       30ms

button buy
  label        "Buy"
  hint         "Buy the plot you landed on, or pass. The bank has no auction."
  haptic       24ms

button build
  label        "Build"
  hint         "Own a whole district to add storeys, up to 3 on each plot, one at a time and evenly."
  haptic       20ms

button offer
  label        "Offer a trade"
  hint         "Once a turn: offer one of your plots to one player for cash. They have 20 seconds to answer."
  haptic       16ms

buzz                         # ms on, off, on…
  turn         40 60 40      # it is your roll
  rent         120           # you paid rent
  paid         25 40 25      # someone paid you
  offer        30 50 30 50 30
  win          40 40 40 40 120
  out          300

tune                         # the computer players' pace, in ms
  bot-think    1500          # a bot thinks this long before a move (plus up to half again)
