# Blast Party: a stick to move, a big Bomb button, and smaller Punch and Jump.
# Syntax and every setting: web/src/games/kit/pad.ts

controller
  orientation  any
  send-rate    40hz

stick move
  label        "Move"
  mode         floating
  follow       yes
  travel       44px
  full-at      82%
  deadzone     8%
  curve        0.9
  directions   any
  haptic       8ms
  rim-haptic   0ms

button bomb
  label        "Bomb"
  hint         "Throw a bomb the way you face. It rolls and goes off after two seconds, or when it hits someone fast."
  icon         action
  style        primary
  shape        rounded
  haptic       16ms
  fires        press

button punch
  label        "Punch"
  hint         "A short punch in front of you. It knocks back a fighter, or bats a bomb away."
  icon         splat
  style        secondary
  shape        rounded
  haptic       12ms
  fires        press

button jump
  label        "Jump"
  hint         "A short hop. It dodges a blast's ground shock and clears a small gap."
  icon         jump
  style        secondary
  shape        rounded
  haptic       10ms
  fires        press

buzz
  go           40
  hit          60 30 90
  out          90 50 160
  pick         25
