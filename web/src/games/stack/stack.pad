# Stack Attack: Left and Right (hold to slide), Turn, Drop (straight down), and a small Down (hold to ease down).
# The pad language allows four buttons, so the small Down is added by controller.ts (its haptic: down-haptic).
# Left and Right repeat while held: the delay and the rate are the tune numbers below.
# Syntax and every setting: web/src/games/kit/pad.ts

controller
  orientation  any

button left
  label        "Left"
  hint         "Slide left. Hold to keep sliding."
  style        primary
  haptic       6ms

button right
  label        "Right"
  hint         "Slide right. Hold to keep sliding."
  style        primary
  haptic       6ms

button rotate
  label        "Turn"
  hint         "Turn the piece clockwise."
  style        primary
  haptic       10ms

button drop
  label        "Drop"
  hint         "Drop the piece straight down. Hold the small Down below Left and Right to ease it down instead."
  style        primary
  haptic       14ms

buzz
  lock         10
  clear        30 40 30
  hit          70 40 70
  out          120 60 200
  go           40

tune
  repeat-delay 170
  repeat-every 55
  down-haptic  6
