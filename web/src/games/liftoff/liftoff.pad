# Lift-off: one big button. Hold it to fire your thruster. A lone pilot gets two: the left and right engines.
# Syntax and every setting: web/src/games/kit/pad.ts

controller
  orientation  portrait
  send-rate    60hz

button thrust
  label        "Thrust"
  hint         "Hold to fire your thruster. Off-centre thrusters also turn the rocket."
  style        primary
  shape        round
  haptic       10ms

button left
  label        "Left engine"
  hint         "Flying alone: hold to fire the left engine (tips the nose right)."
  style        primary
  haptic       10ms

button right
  label        "Right engine"
  hint         "Flying alone: hold to fire the right engine (tips the nose left)."
  style        primary
  haptic       10ms

buzz
  crash        90 50 160
  go           40
