# Rotor Brawl: fly a little machine and swing a heavy weapon.
# A fixed joystick flies the machine (upright: centred, 3/4 down; sideways: on the left); flying in circles swings the weapon.
# Syntax and every setting: web/src/games/kit/pad.ts

controller
  orientation  any
  send-rate    60hz

stick fly
  label        "Fly"
  mode         fixed
  travel       64px
  full-at      90%
  deadzone     5%
  curve        1
  haptic       10ms

buzz
  hit          25
  hurt         60 30 90
  ko           220 80 220
  win          40 40 40 40 120

tune
  # input units per frame at most (the cap on the thrust)
  # 2026-11-17 play test: "too sensitive" -> stick and steer at 0.7 of 600 / 8 (same top speed, softer reaction)
  stick        420
  # Not in Hammerfight: the stick sets a target speed (tilt x top speed), and the thrust closes the gap.
  # steer: input units per px/s of speed error; hold: input units per px/s of target speed (against the drag).
  # Measured (stickprobe): turn-round at half tilt 500-780 ms with the old stick-cubed map, 120-160 ms with steer 8.
  steer        5.6
  hold         0.5
