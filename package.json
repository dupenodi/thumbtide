{
  "name": "thumbtide",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @thumbtide/server dev",
    "dev:web": "pnpm --filter @thumbtide/web dev",
    "build": "pnpm --filter @thumbtide/web build",
    "tv": "pnpm --filter @thumbtide/web tv",
    "test": "pnpm -r test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
